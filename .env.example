# Variables de entorno - Plataforma Nacional de Inteligencia Territorial
# Copia este archivo a .env y ajusta los valores locales. No subas .env al repo.

POSTGRES_DB=territorio
POSTGRES_USER=territorio
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

DJANGO_SECRET_KEY=changeme_dev_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MARTIN_HOST=0.0.0.0
MARTIN_PORT=3001

ETL_AREA_DIFF_THRESHOLD_PCT=10
